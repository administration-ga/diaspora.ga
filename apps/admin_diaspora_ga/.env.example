# admin.diaspora.ga — variables de l'application (NOMS seulement : le dépôt est public).
#
# En DÉVELOPPEMENT, rien à poser ici pour le moteur : la configuration commune
# (@antsia/api/next-config) lit le déploiement Convex courant dans ANTSIA/.env.local,
# que `bun run dev:convex` écrit lui-même.
# En PRODUCTION, ces valeurs arrivent par les ARG du Dockerfile (entrée
# admin_diaspora_ga de ANTSIA/deploy/catalog.json).

# URL du déploiement Convex (client navigateur) — inscrite dans le bundle au build.
NEXT_PUBLIC_CONVEX_URL=
# URL des actions HTTP du déploiement (proxy d'authentification, côté serveur).
CONVEX_SITE_URL=
# Origine publique de l'application d'administration.
NEXT_PUBLIC_SITE_URL=
# Origine publique de l'application des membres (lien « Ouvrir diaspora.ga ») ;
# absente, le lien ne s'affiche pas (jamais de lien mort).
NEXT_PUBLIC_MEMBERS_SITE_URL=
# Commit construit, affiché par /sante-fonctionnelle.
NEXT_PUBLIC_BUILD_SHA=
