{
  "expo": {
    "name": "DIASPORA",
    "scheme": "diasporaga",
    "slug": "diaspora-ga-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ga.diaspora.mobile",
      "appleTeamId": "5Y39TTNCM7",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:diaspora.ga"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Partager une photo ou participer à un appel.",
        "NSMicrophoneUsageDescription": "Utiliser le micro lors d’un appel ou d’un direct.",
        "NSPhotoLibraryUsageDescription": "Choisir une photo ou une vidéo à publier."
      }
    },
    "android": {
      "package": "ga.diaspora.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "diaspora.ga",
              "path": "/mobile/ouvrir"
            },
            {
              "scheme": "https",
              "host": "diaspora.ga",
              "path": "/mobile/retour"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      }
    },
    "owner": "okatechs-organization",
    "extra": {
      "eas": {
        "projectId": "12829e48-0c3b-499a-ae77-bf30f80b2a88"
      }
    }
  }
}
